POSTGRES_DB=ai_content_os
POSTGRES_USER=ai_content_os
POSTGRES_PASSWORD=<set-a-local-password>
DATABASE_URL=postgresql+psycopg://ai_content_os:<set-a-local-password>@localhost:5432/ai_content_os
BACKEND_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
SECRET_ENCRYPTION_NOTE=Store real API keys and platform tokens in backend environment or backend secrets table only. Never put them in frontend code.
RUNWAYML_API_SECRET=
RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_API_VERSION=2024-11-06
RUNWAY_DEFAULT_MODEL=gen4.5
RUNWAY_TIMEOUT_SECONDS=30
